
Завдання 1: Парсер платежів (CSV)
Що відбувається:
Ми використовуємо BufferedReader для лінійного читання текстового файлу.
Це ефективніше, ніж читати весь файл одразу в пам'ять.
 Ми пропускаємо перший рядок (заголовок), а кожен наступний розбиваємо по комі (,).
 Для зберігання даних використовуємо record — це лаконічний спосіб створити клас-носій даних у сучасній Java.

enum PaymentStatus {
    NEW, PAID, FAILED
}

record Payment(String id, String email, PaymentStatus status, long amountCents) {}

class LoadResult {
    List<Payment> payments;
    int invalidLines;

    LoadResult(List<Payment> payments, int invalidLines) {
        this.payments = payments;
        this.invalidLines = invalidLines;
    }
}

public class PaymentLoader {
    public static LoadResult loadWithStats(Path csvPath) {
        List<Payment> payments = new ArrayList<>();
        int invalidLines = 0;

        try (BufferedReader reader = Files.newBufferedReader(csvPath)) {
            String line = reader.readLine(); // Пропускаємо заголовок

            while ((line = reader.readLine()) != null) {
                if (line.isBlank()) {
                    invalidLines++;
                    continue;
                }

                try {
                    String[] parts = line.split(",");
                    if (parts.length < 4) throw new IllegalArgumentException("Invalid format");

                    Payment payment = new Payment(
                        parts[0].trim(),
                        parts[1].trim(),
                        PaymentStatus.valueOf(parts[2].trim().toUpperCase()),
                        Long.parseLong(parts[3].trim())
                    );
                    payments.add(payment);
                } catch (Exception e) {
                    invalidLines++;
                }
            }
        } catch (IOException e) {
            System.err.println("Помилка читання файлу: " + e.getMessage());
        }

        return new LoadResult(payments, invalidLines);
    }
}


--- 2 АТОМАРНІСТЬ ----

//
Завдання 2: Звіт у файл (Атомарність)
Що відбувається:
Головна фішка тут — атомарність.
 Якщо під час запису звіту вимкнеться світло або програма впаде, ми не хочемо мати "битий" або порожній файл.
 Тому ми пишемо у тимчасовий файл, а потім "миттєво" замінюємо ним оригінальний за допомогою Files.move.



import java.io.BufferedWriter;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardCopyOption;
import java.util.List;
import java.util.Map;
import java.util.stream.Collectors;

public class PaymentReportWriter {
    public static void writeReport(Path out, List<Payment> payments, int invalidLines) throws IOException {
        // Створюємо тимчасовий файл у тій же директорії
        Path tempFile = Files.createTempFile(out.getParent(), "report-", ".tmp");

        try (BufferedWriter writer = Files.newBufferedWriter(tempFile)) {
            long paidTotal = payments.stream()
                .filter(p -> p.status() == PaymentStatus.PAID)
                .mapToLong(Payment::amountCents)
                .sum();

            Map<PaymentStatus, Long> counts = payments.stream()
                .collect(Collectors.groupingBy(Payment::status, Collectors.counting()));

            writer.write("invalidLines=" + invalidLines);
            writer.newLine();
            writer.write("paidTotalCents=" + paidTotal);
            writer.newLine();
            writer.write(String.format("NEW=%d, PAID=%d, FAILED=%d",
                counts.getOrDefault(PaymentStatus.NEW, 0L),
                counts.getOrDefault(PaymentStatus.PAID, 0L),
                counts.getOrDefault(PaymentStatus.FAILED, 0L)));
        }

        // Атомарне переміщення
        Files.move(tempFile, out, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);
    }
}



- 3---

Що відбувається:
Використовуємо DirectoryStream для фільтрації файлів за маскою (glob *.tmp).
Це набагато продуктивніше за list(), бо не завантажує всі імена файлів у масив одразу.
public class InboxArchiver {
    public static void archiveTmpFiles(Path inbox, Path archive) throws IOException {
        if (!Files.exists(archive)) Files.createDirectories(archive);

        try (var stream = Files.newDirectoryStream(inbox, "*.tmp")) {
            for (Path entry : stream) {
                Path target = archive.resolve(entry.getFileName());
                Files.move(entry, target, StandardCopyOption.REPLACE_EXISTING);
                System.out.println("Архівовано: " + entry.getFileName());
            }
        }
    }
}


- 4----

Що відбувається:
Користувач може спробувати ввести ../../etc/passwd. Щоб цього уникнути, ми резолвимо шлях, нормалізуємо його (видаляємо ..)
 і перевіряємо, чи починається результат з нашої базової директорії.

public class PathSafety {
     public static Path safeResolve(Path base, String userInput) {
         Path resolved = base.resolve(userInput).normalize();

         if (!resolved.startsWith(base.normalize())) {
             throw new IllegalArgumentException("Path traversal attempt detected: " + userInput);
         }
         return resolved;
     }
 }

